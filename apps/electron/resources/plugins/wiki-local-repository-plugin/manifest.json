{
  "manifestVersion": 1,
  "id": "wiki-local-repository-plugin",
  "name": "本地仓库 Wiki",
  "version": "0.2.2",
  "description": "分析本地代码仓库并构建可检索文档库，支持任务控制与继续聊天",
  "author": "Proma",
  "entry": {
    "main": "index.mjs"
  },
  "permissions": [
    "filesystem:read",
    "filesystem:write",
    "llm:invoke",
    "channels:read"
  ],
  "capabilities": [
    {
      "key": "wiki:local-repository",
      "title": "本地仓库 Wiki",
      "description": "分析本地仓库并构建知识库，支持继续聊天",
      "config": {
        "version": "v1",
        "workbenchCanvasHook": true
      }
    }
  ],
  "workbench": {
    "canvas": {
      "enabled": true,
      "version": 1,
      "getCanvasHook": "getWorkbenchCanvas",
      "invokeActionHook": "invokeWorkbenchAction"
    }
  }
}
