\"text-sm text-muted-foreground\\\">\\n                  {chatNode.emptyText ?? '暂无对话，输入问题开始继续聊天。'}\\n                </p>\\n              )}\\n            </div>\\n\\n            {state.references.length > 0 && (\\n              <div className=\\\"rounded-lg border border-border/50 bg-muted/10 p-3 space-y-2\\\">\\n                <p className=\\\"text-xs font-medium text-muted-foreground\\\">引用片段</p>\\n                <ul className=\\\"space-y-1\\\">\\n                  {state.references.map((item) => (\\n                    <li key={`${nodeKey}-${item.chunkId}`} className=\\\"text-xs text-muted-foreground\\\">\\n                      <span className=\\\"font-mono\\\">{item.filePath}</span>\\n                      {' · '}\\n                      score={item.score.toFixed(3)}\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n            )}\\n\\n            {state.error && (\\n              <p className=\\\"text-xs text-destructive\\\">{state.error}</p>\\n            )}\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <Input\\n                value={state.draft}\\n                placeholder={chatNode.placeholder ?? '基于文档库继续提问...'}\\n                onChange={(event) => {\\n                  updateChatState(nodeKey, (current) => ({\\n                    ...current,\\n                    draft: event.target.value,\\n                    knowledgeBaseId: chatNode.knowledgeBaseId,\\n                  }), chatNode)\\n                }}\\n                onKeyDown={(event) => {\\n                  if (event.key === 'Enter' && !event.shiftKey) {\\n                    event.preventDefault()\\n                    void sendDocumentChat(nodeKey, chatNode)\\n                  }\\n                }}\\n              />\\n              <Button\\n                size=\\\"sm\\\"\\n                disabled={state.pending || state.draft.trim().length === 0}\\n                onClick={() => {\\n          