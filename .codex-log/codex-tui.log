ontext) => Promise<void> | void\n   431\t  deactivate?: () => Promise<void> | void\n   432\t  invokeCapability?: (\n   433\t    capabilityKey: string,\n   434\t    payload?: Record<string, unknown>,\n   435\t  ) => Promise<unknown> | unknown\n   436\t  /**\n   437\t   * 获取插件工作台声明式画布\n   438\t   *\n   439\t   * 允许直接返回画布对象，或返回统一响应结构。\n   440\t   */\n   441\t  getWorkbenchCanvas?: (\n   442\t    request?: PluginWorkbenchCanvasRequest,\n   443\t  ) =>\n   444\t    | Promise<PluginWorkbenchCanvas | PluginWorkbenchCanvasResult>\n   445\t    | PluginWorkbenchCanvas\n   446\t    | PluginWorkbenchCanvasResult\n   447\t  /**\n   448\t   * 处理插件工作台动作调用\n   449\t   *\n   450\t   * 允许直接返回任意数据，或返回统一响应结构。\n   451\t   */\n   452\t  invokeWorkbenchAction?: (\n   453\t    action: PluginWorkbenchActionTrigger,\n   454\t  ) => Promise<PluginWorkbenchActionInvokeResult | unknown> | PluginWorkbenchActionInvokeResult | unknown\n   455\t}\n   456\t\n   457\t/** 插件相关 IPC 通道常量 */\n   458\texport const PLUGIN_IPC_CHANNELS = {\n   459\t  /** 获取插件列表 */\n   460\t  LIST: 'plugin:list',\n   461\t  /** 从本地路径安装插件 */\n   462\t  INSTALL_LOCAL: 'plugin:install-local',\n   463\t  /** 启用插件 */\n   464\t  ENABLE: 'plugin:enable',\n   465\t  /** 禁用插件 */\n   466\t  DISABLE: 'plugin:disable',\n   467\t  /** 卸载插件 */\n   468\t  UNINSTALL: 'plugin:uninstall',\n   469\t  /** 获取插件状态 */\n   470\t  GET_STATUS: 'plugin:get-status',\n   471\t  /** 调用插件能力 */\n   472\t  INVOKE_CAPABILITY: 'plugin:invoke-capability',\n   473\t  /** 获取插件工作台列表 */\n   474\t  WORKBENCH_LIST: 'plugin:workbench:list',\n   475\t  /** 获取插件工作台画布 */\n   476\t  WORKBENCH_GET_CANVAS: 'plugin:workbench:get-canvas',\n   477\t  /** 调用插件工作台动作 */\n   478\t  WORKBENCH_INVOKE_ACTION: 'plugin:workbench:invoke-action',\n   479\t} as const\n"), success: Some(true) } } })
