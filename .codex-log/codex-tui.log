nup: () => void | Promise<void>) => void\n    40\t    invokePluginCapability: (capabilityKey: string, payload?: Record<string, unknown>) => Promise<unknown>\n    41\t    invokeWorkbenchAction: (\n    42\t      input: PluginInvokeWorkbenchActionInput,\n    43\t    ) => Promise<PluginWorkbenchActionInvokeResult>\n    44\t  },\n    45\t): PluginRuntimeContext {\n    46\t  return {\n    47\t    pluginId: manifest.id,\n    48\t    installPath,\n    49\t    workspacePath,\n    50\t    lifecycle: {\n    51\t      signal: options.abortSignal,\n    52\t      onCleanup: options.registerCleanup,\n    53\t      throwIfAborted: (): void => {\n    54\t        if (options.abortSignal.aborted) {\n    55\t          throw new Error(`插件已终止: ${manifest.id}`)\n    56\t        }\n    57\t      },\n    58\t    },\n    59\t    api: {\n    60\t      llm: {\n    61\t        invoke: async (_input: Record<string, unknown>): Promise<string> => {\n    62\t          assertPluginPermission(manifest, 'llm:invoke')\n    63\t          if (options.abortSignal.aborted) {\n    64\t            throw new Error(`插件已终止: ${manifest.id}`)\n    65\t          }\n    66\t          throw new Error('插件 LLM 能力暂未实现')\n    67\t        },\n    68\t      },\n    69\t      fs: {\n    70\t        readText: async (targetPath: string): Promise<string> => {\n    71\t          assertPluginPermission(manifest, 'filesystem:read')\n    72\t          if (options.abortSignal.aborted) {\n    73\t            throw new Error(`插件已终止: ${manifest.id}`)\n    74\t          }\n    75\t          const safePath = resolveWorkspaceFilePath(workspacePath, targetPath)\n    76\t          return readFileSync(safePath, 'utf-8')\n    77\t        },\n    78\t        writeText: async (targetPath: string, content: string): Promise<void> => {\n    79\t          assertPluginPermission(manifest, 'filesystem:write')\n    80\t          if (options.abortSignal.aborted) {\n    81\t            throw new Error(`插件已终止: ${manifest.id}`)\n    82\t          }\n    83\t          const safePath = resolveWorkspaceFilePath(workspacePath, targetPath)\n    84\t          mkdirSync(dirname(safePath), { recursive: true })\n    85\t          writeFileSync(safePath, content, 'utf-8')\n    86\t        },\n    87\t      },\n    88\t      mcp: {\n    89\t        callTool: async (\n    90\t          _serverName: string,\n    91\t          _toolName: string,\n    92\t          _args: Record<string, unknown>,\n    93\t        ): Promise<unknown> => {\n    94\t          assertPluginPermission(manifest, 'mcp:access')\n    95\t          if (options.abortSignal.aborted) {\n    96\t            throw new Error(`插件已终止: ${manifest.id}`)\n    97\t          }\n    98\t          throw new Error('插件 MCP 能力暂未实现')\n    99\t        },\n   100\t      },\n   101\t      events: {\n   102\t        emit: (_event: string, _payload?: Record<string, unknown>): void => {\n   103\t          assertPluginPermission(manifest, 'events:emit')\n   104\t          if (options.abortSignal.aborted) {\n   105\t            throw new Error(`插件已终止: ${manifest.id}`)\n   106\t          }\n   107\t        },\n   108\t      },\n   109\t      workbench: {\n   110\t        readFile: async (targetPath: string): Promise<string> => {\n   111\t          assertPluginPermission(manifest, 'filesystem:read')\n   112\t          if (options.abortSignal.aborted) {\n   113\t            throw new Error(`插件已终止: ${manifest.id}`)\n   114\t          }\n   115\t          const safePath = resolveWorkspaceFilePath(workspacePath, targetPath)\n   116\t          return readFileSync(safePath, 'utf-8')\n   117\t        },\n   118\t        invokeCapability: async (\n   119\t          capabilityKey: string,\n   120\t          payload?: Record<string, unknown>,\n   121\t        ): Promise<unknown> => {\n   122\t          if (options.abortSignal.aborted) {\n   123\t            throw new Error(`插件已终止: ${manifest.id}`)\n   124\t          }\n   125\t\n   126\t          return options.invokePluginCapability(capability