keyFiles\n    .map((item) => {\n      return `### ${item.path}\\n\\n\\`\\`\\`\\n${item.preview}\\n\\`\\`\\``\n    })\n    .join('\\n\\n')\n\n  return [\n    '# 本地仓库 Wiki（V1）',\n    '',\n    `- 目标仓库：\\`${rootPath}\\``,\n    `- 目录数量：${directories}`,\n    `- 文件数量：${files}`,\n    `- 代码文件数量：${codeFiles}`,\n    '',\n    '## 顶层结构',\n    topLevelLines || '- (空)',\n    '',\n    '## 代码文件样本',\n    sampleLines || '- (无)',\n    '',\n    '## 关键文件摘要',\n    keyFileLines || '暂无关键文件',\n  ].join('\\n')\n}\n"), success: Some(true) } } })
