: ${String(actionId)}`)\\n  }\\n\\n  try {\\n    const payload = {\\n      ...(action?.payload ?? {}),\\n      action: actionId,\\n    }\\n\\n    const result = await runCapabilityAction(payload)\\n\\n    const message = actionId === WORKBENCH_ACTION_ID.analyze\\n      ? '扫描任务已启动，可在状态区查看进度。'\\n      : actionId === WORKBENCH_ACTION_ID.getLatest\\n        ? '已读取最新结果。'\\n        : `任务控制命令已发送：${actionId}`\\n\\n    return {\\n      success: true,\\n      data: {\\n        type: 'toast',\\n        level: 'success',\\n        message,\\n        data: result,\\n      },\\n    }\\n  } catch (error) {\\n    const message = error instanceof Error ? error.message : String(error)\\n    return createWorkbenchError(WORKBENCH_ERROR_CODE.hookFailed, message)\\n  }\\n}\\nEOF\"}" } }}:dispatch_tool_call{otel.name="exec_command" tool_name="exec_command" call_id="call_sN4XRh75zJoVBFgkHPvhZ5MR" aborted=false}: codex_core::tools::parallel: close time.busy=6.26ms time.idle=99.4ms
