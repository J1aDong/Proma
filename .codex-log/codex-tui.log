* number 最小值 */\n   202\t  min?: number\n   203\t  /** number 最大值 */\n   204\t  max?: number\n   205\t  /** number 步长 */\n   206\t  step?: number\n   207\t}\n   208\t\n   209\t/** 工作台动作定义（用于声明式 UI 交互） */\n   210\texport interface PluginWorkbenchActionDefinition {\n   211\t  /** 动作唯一标识 */\n   212\t  id: string\n   213\t  /** 动作显示名称 */\n   214\t  label: string\n   215\t  /** 动作描述 */\n   216\t  description?: string\n   217\t  /** 动作样式 */\n   218\t  variant?: PluginWorkbenchActionVariant\n   219\t  /** 是否禁用 */\n   220\t  disabled?: boolean\n   221\t  /** 触发动作时携带的默认参数 */\n   222\t  payload?: Record<string, unknown>\n   223\t  /** 动作输入定义（由宿主渲染通用输入控件） */\n   224\t  inputs?: PluginWorkbenchActionInputDefinition[]\n   225\t}\n   226\t\n   227\t/** 工作台节点基础结构 */\n   228\texport interface PluginWorkbenchBaseNode {\n   229\t  /** 节点类型 */\n   230\t  type: PluginWorkbenchNodeType\n   231\t  /** 节点唯一标识（可选） */\n   232\t  id?: string\n   233\t  /** 节点标题 */\n   234\t  title?: string\n   235\t  /** 节点描述 */\n   236\t  description?: string\n   237\t}\n   238\t\n   239\t/** 页面容器节点 */\n   240\texport interface PluginWorkbenchPageNode extends PluginWorkbenchBaseNode {\n   241\t  type: 'page'\n   242\t  children: PluginWorkbenchNode[]\n   243\t}\n   244\t\n   245\t/** 面板容器节点 */\n   246\texport interface PluginWorkbenchPanelNode extends PluginWorkbenchBaseNode {\n   247\t  type: 'panel'\n   248\t  children: PluginWorkbenchNode[]\n   249\t}\n   250\t\n   251\t/** 分栏节点 */\n   252\texport interface PluginWorkbenchSplitNode extends PluginWorkbenchBaseNode {\n   253\t  type: 'split'\n   254\t  direction: PluginWorkbenchSplitDirection\n   255\t  /** 子节点比例，按 children 顺序对应 */\n   256\t  ratios?: number[]\n   257\t  children: PluginWorkbenchNode[]\n   258\t}\n   259\t\n   260\t/** 卡片节点 */\n"), success: Some(true) } } })
