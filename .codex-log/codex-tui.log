+  /** 当前阶段（如 scan/chunk/embed/persist） */
+  stage: string
+  /** 百分比进度 0-100 */
+  percent: number
+  /** 可读进度描述 */
+  detail?: string
+  /** 已处理数量 */
+  processed?: number
+  /** 总数量 */
+  total?: number
+}
+
+/** 插件任务快照 */
+export interface PluginTaskSnapshot {
+  taskId: string
