   691\t  }\n   692\t\n   693\t  if (record.state !== 'active') {\n   694\t    return {\n   695\t      success: false,\n   696\t      pluginId: record.id,\n   697\t      capabilityKey: input.capabilityKey,\n   698\t      error: `插件未启用，当前状态: ${record.state}`,\n   699\t    }\n   700\t  }\n   701\t\n   702\t  const capabilityDeclared = record.manifest.capabilities.some(\n   703\t    (item) => item.key === input.capabilityKey,\n   704\t  )\n   705\t  if (!capabilityDeclared) {\n   706\t    return {\n   707\t      success: false,\n   708\t      pluginId: record.id,\n   709\t      capabilityKey: input.capabilityKey,\n   710\t      error: `插件未声明能力: ${input.capabilityKey}`,\n   711\t    }\n   712\t  }\n   713\t\n   714\t  const runtime = activePluginRuntimeMap.get(record.id)\n   715\t  if (!runtime?.module.invokeCapability) {\n   716\t    return {\n   717\t      success: false,\n   718\t      pluginId: record.id,\n   719\t      capabilityKey: input.capabilityKey,\n   720\t      error: '插件未实现 invokeCapability',\n   721\t    }\n   722\t  }\n   723\t\n   724\t  try {\n   725\t    const data = await runtime.module.invokeCapability(input.capabilityKey, input.payload)\n   726\t    return {\n   727\t      success: true,\n   728\t      pluginId: record.id,\n   729\t      capabilityKey: input.capabilityKey,\n   730\t      data,\n   731\t    }\n   732\t  } catch (error) {\n   733\t    let message = error instanceof Error ? error.message : String(error)\n   734\t\n   735\t    if (runtime) {\n   736\t      try {\n   737\t        await runPluginCleanup(runtime)\n   738\t      } catch (cleanupError) {\n   739\t        const cleanupMessage = cleanupError instanceof Error ? cleanupError.message : String(cleanupError)\n   740\t        message = `${message} | ${cleanupMessage}`\n   741\t      }\n   742\t    }\n   743\t\n   744\t    updatePluginState(record.id, 'error', { lastError: message })\n   745\t    activePluginRuntimeMap.delete(record.id)\n   746\t\n   747\t    return {\n   748\t     