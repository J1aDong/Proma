,\n   627\t  }\n   628\t}\n   629\t\n   630\t/** 卸载插件（先禁用再删除目录与索引） */\n   631\texport async function uninstallPlugin(input: PluginLifecycleInput): Promise<PluginOperationResult> {\n   632\t  const record = getPluginRecord(input.pluginId)\n   633\t  if (!record) {\n   634\t    throw new Error(`插件不存在: ${input.pluginId}`)\n   635\t  }\n   636\t\n   637\t  await disablePlugin({ pluginId: record.id })\n   638\t\n   639\t  rmSync(record.installPath, { recursive: true, force: true })\n   640\t  rmSync(record.workspacePath, { recursive: true, force: true })\n   641\t\n   642\t  const removed = removePluginRecord(record.id)\n   643\t\n   644\t  return {\n   645\t    success: true,\n   646\t    pluginId: record.id,\n   647\t    state: 'uninstalled',\n   648\t    plugin: removed ?? undefined,\n   649\t    message: '插件已卸载',\n   650\t  }\n   651\t}\n   652\t\n   653\t/** 获取插件状态 */\n   654\texport function getPluginStatus(input: PluginStatusInput): PluginStatusResult {\n   655\t  const record = getPluginRecord(input.pluginId)\n   656\t  if (!record) {\n   657\t    throw new Error(`插件不存在: ${input.pluginId}`)\n   658\t  }\n   659\t\n   660\t  return {\n"), success: Some(true) } } })
