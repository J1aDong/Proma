+      }
+
+      if (value.placeholder !== undefined && typeof value.placeholder !== 'string') {
+        return false
+      }
+
+      if (value.emptyText !== undefined && typeof value.emptyText !== 'string') {
+        return false
+      }
+
+      if (value.topK !== undefined && (typeof value.topK !== 'number' || !Number.isFinite(value.topK))) {
+        return false
+      }
+
+      return true
+    }
     default: {
       return false
     }
