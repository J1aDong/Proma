\t  getReleaseByTag,\n   146\t} from './lib/github-release-service'\n   147\t\n   148\t/**\n   149\t * 注册 IPC 处理器\n   150\t *\n   151\t * 注册的通道：\n   152\t * - runtime:get-status: 获取运行时状态\n   153\t * - git:get-repo-status: 获取指定目录的 Git 仓库状态\n   154\t * - channel:*: 渠道管理相关\n   155\t * - chat:*: 对话管理 + 消息发送 + 流式事件\n   156\t */\n   157\texport function registerIpcHandlers(): void {\n   158\t  console.log('[IPC] 正在注册 IPC 处理器...')\n   159\t\n   160\t  // ===== 运行时相关 =====\n   161\t\n   162\t  // 获取运行时状态\n   163\t  ipcMain.handle(\n   164\t    IPC_CHANNELS.GET_RUNTIME_STATUS,\n   165\t    async (): Promise<RuntimeStatus | null> => {\n   166\t      return getRuntimeStatus()\n   167\t    }\n   168\t  )\n   169\t\n   170\t  // 获取指定目录的 Git 仓库状态\n   171\t  ipcMain.handle(\n   172\t    IPC_CHANNELS.GET_GIT_REPO_STATUS,\n   173\t    async (_, dirPath: string): Promise<GitRepoStatus | null> => {\n   174\t      if (!dirPath || typeof dirPath !== 'string') {\n   175\t        console.warn('[IPC] git:get-repo-status 收到无效的目录路径')\n   176\t        return null\n   177\t      }\n   178\t\n   179\t      return getGitRepoStatus(dirPath)\n   180\t    }\n", stderr: "", aggregated_output: "     1\t/**\n     2\t * IPC 处理器模块\n     3\t *\n     4\t * 负责注册主进程和渲染进程之间的通信处理器\n     5\t */\n     6\t\n     7\timport { ipcMain, nativeTheme, shell, dialog, BrowserWindow } from 'electron'\n     8\timport { IPC_CHANNELS, CHANNEL_IPC_CHANNELS, CHAT_IPC_CHANNELS, AGENT_IPC_CHANNELS, PLUGIN_IPC_CHANNELS, ENVIRONMENT_IPC_CHANNELS, PROXY_IPC_CHANNELS, GITHUB_RELEASE_IPC_CHANNELS } from '@proma/shared'\n     9\timport { USER_PROFILE_IPC_CHANNELS, SETTINGS_IPC_CHANNELS } from '../types'\n    10\timport type {\n    11\t  RuntimeStatus,\n    12\t  GitRepoStatus,\n    13\t  Channel,\n    14\t  ChannelCreateInput,\n    15\t  ChannelUpdateInput,\n    16\t  ChannelTestResult,\n    17\t  FetchModelsInput,\n    18\t  FetchModelsResult,\n    19\t  ConversationMeta,\n    20\t  ChatMessage,\n    21\t  ChatSendInput,\n    22\t  